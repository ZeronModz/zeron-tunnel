<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainCons"
        android:background="@drawable/bg_navheader"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_map"
            android:scaleType="fitXY"
            android:backgroundTint="@color/textColor"/>
        <RelativeLayout
            android:padding="30dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/nav_header_image"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:src="@drawable/icon"
                android:scaleType="centerCrop"
                android:layout_centerInParent="true"
                style="@style/CircleImageView"/>
            <TextView
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/textColor"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/nav_header_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app"
                android:layout_marginStart="10dp"/>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/cardVIPLOGIN"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        app:cardCornerRadius="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mainCons">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/nav_headerbtn_bg"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <ImageView
                android:id="@+id/imgCrown"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/crown"
                android:layout_marginStart="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/imgCrown"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/card_mainLayoutColor"
                    android:id="@+id/vip_login_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UNLOCK VIP ACCESS"
                    android:maxLines="1"
                    android:layout_marginStart="5dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/card_mainLayoutColor"
                    android:ellipsize="end"
                    android:id="@+id/vip_Login_timeleft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remove ads, remove timer, enjoy premium access"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <View
        android:background="@color/main_bg"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/cardVIPLOGIN"/>
</androidx.constraintlayout.widget.ConstraintLayout>
