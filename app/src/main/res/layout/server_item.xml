<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardServer"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="5dp"
    android:paddingEnd="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/search_bg"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:layout_marginEnd="19dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/serverFlag"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/icon"
            android:scaleType="fitXY"
            android:layout_centerVertical="true"
            android:layout_marginStart="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="4dp"
            android:layout_toEndOf="@+id/serverFlag"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/rbServer"
            app:layout_constraintStart_toEndOf="@+id/serverFlag"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/textColor"
                android:gravity="start"
                android:layout_gravity="start"
                android:id="@+id/tvServerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Server Name"/>
            <TextView
                android:textSize="8sp"
                android:textColor="@color/textColor"
                android:gravity="start"
                android:id="@+id/tvServerProto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Server Proto"/>
        </LinearLayout>
        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rbServer"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="-10dp"
            android:layout_alignParentEnd="true"
            app:buttonTint="@color/colorAccent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/imgSpeedBoost"
        android:layout_width="110dp"
        android:layout_height="50dp"
        android:src="@drawable/speedboost"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/pbBoost"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:indeterminate="true"
        android:layout_marginEnd="30dp"
        android:indeterminateTint="@color/colorAccent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imgBoosted"
        android:layout_width="110dp"
        android:layout_height="38dp"
        android:src="@drawable/boosted"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
