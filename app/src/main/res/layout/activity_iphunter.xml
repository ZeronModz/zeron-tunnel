<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="@drawable/a_gradient"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        android:id="@+id/appBarTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:background="@color/gradCenter"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Ip Hunter"
            app:titleTextColor="@color/textColor"/>
    </com.google.android.material.appbar.AppBarLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/topinput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Enter IP to hunt (ex. 100.10)"
            android:layout_weight="0.7"
            app:hintTextColor="@color/textColor">
            <com.google.android.material.textfield.TextInputEditText
                android:textColor="@color/textColor"
                android:id="@+id/etIP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_test_toggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Start"
            android:layout_weight="0.3"
            android:layout_below="@+id/topinput"
            android:layout_marginStart="10dp"
            style="@style/Widget.Material3.Button.OutlinedButton"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/textColor"
        android:id="@+id/mobileip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Ip"
        android:layout_marginStart="15dp"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/textColor"
        android:id="@+id/attempts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginStart="15dp"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_permission_guide"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Configure Digital Assistant Permission"
        style="@style/Widget.Material3.Button.OutlinedButton"/>
    <androidx.core.widget.NestedScrollView
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_status"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Status Information"/>
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:id="@+id/tv_current_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Current Status: Checking..."/>
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:id="@+id/tv_interval_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Toggle Interval: Every 15 minutes"/>
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:id="@+id/tv_permission_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Permission Status: Checking..."/>
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:id="@+id/tv_secure_perm_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="WRITE_SECURE_SETTINGS: Not detected"/>
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Long press this card to refresh status"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_control"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Control Functions"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto Toggle Control Mode"/>
                        <RadioGroup
                            android:orientation="horizontal"
                            android:id="@+id/rg_control_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <RadioButton
                                android:id="@+id/rb_mode_assistant"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Digital Assistant Mode"/>
                            <RadioButton
                                android:id="@+id/rb_mode_secure"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Secure Settings Mode"
                                android:layout_marginStart="24dp"/>
                        </RadioGroup>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto Timed Toggle"/>
                        <TextView
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto execute: ON → 2s → OFF"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">
                            <EditText
                                android:id="@+id/et_interval"
                                android:padding="12dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:hint="Interval (1-60 minutes)"
                                android:layout_weight="1"
                                android:inputType="number"/>
                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switch_auto_toggle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"/>
                        </LinearLayout>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_set_interval"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Set Interval"
                        style="@style/Widget.Material3.Button.OutlinedButton"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_test_secure"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Test Secure Settings Toggle"
                        style="@style/Widget.Material3.Button.OutlinedButton"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_view_logs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="View Operation Logs"
                        style="@style/Widget.Material3.Button.OutlinedButton"/>
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Long press test button for more options"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_permission"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="权限配置"/>
                    <TextView
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="To control airplane mode, set this app as the digital assistant. Click the button below to configure, or long press to refresh permission status."/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progress_bar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
